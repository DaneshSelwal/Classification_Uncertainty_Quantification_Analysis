# Ignore large model artifact directories and model weights
**/models/
**/models/**
*.keras
*.h5
*.tar.gz
*.zip
*.tar
*.gz

# Ignore local tools and original data
tools/
data/
legacy_and_temp_files/

# Ignore localized data in suites (prevent pushing large files)
classification_uncertainty_quantification/data/
examples/*/data/

# Notebook checkpoints and caches
.ipynb_checkpoints/
**/.ipynb_checkpoints/
__pycache__/
*.py[cod]
bin/
markdowns/
*.docx
.DS_Store

# Kaggle staging, environment, and credentials protection
kaggle_staging/
**/kaggle_staging/
.env
*.env
.env.*
*token*
*.token
*.key
tokens/
